# 네이버 커머스 API
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# GS택배 (cvsnet.co.kr)
GS_USERNAME=your_username_here
GS_PASSWORD=your_password_here

# 보내는 사람 (발송인)
# GS택배 "나의 주소록"에 등록한 발송인 이름 — 예약 시 이 이름으로 주소록 항목을 자동 선택합니다.
# (전화·주소·우편번호는 주소록 항목에 저장돼 있어 폼에 따로 입력하지 않습니다)
SENDER_NAME=홍길동

# 방문택배 예약명 (선택, 미설정 시 "방문택배 발송")
VISIT_RESERVATION_NAME=방문택배 발송

# === 앱 로그인 인증 ===
# 대시보드 접근용 로그인 계정 (앱 자체 인증)
AUTH_USERNAME=admin
AUTH_PASSWORD=your_login_password_here
# JWT 세션 서명 키 (랜덤 값, 예: openssl rand -hex 32)
# 이 값이 바뀌면 기존 로그인 세션이 모두 풀립니다
AUTH_SECRET=your_random_jwt_secret_here

# === 서버 배포 설정 ===

# 배포 모드: "server" = 서버(headless Playwright), "local" = 로컬(headed, 기본값)
# 서버 .env.local에만 "server"로 설정
DEPLOY_MODE=local
# 클라이언트(브라우저)에서 참조하는 배포 모드 — DEPLOY_MODE와 동일하게 설정
NEXT_PUBLIC_DEPLOY_MODE=local

# 서버 URL (로컬에서 서버로 동기화할 때 사용)
# 로컬 .env.local에만 설정 (서버에서는 불필요)
SERVER_URL=https://ship.yourdomain.com

# 내부 API 인증 키 (로컬↔서버 통신용)
# 서버와 로컬 모두 동일한 랜덤 값으로 설정 (예: openssl rand -hex 32)
INTERNAL_API_KEY=your_random_secret_key_here

# === 배포 설정 (로컬 `npm run deploy` 에서 사용) ===
# 서버에서는 불필요
DEPLOY_SSH_HOST=user@your.server.host
DEPLOY_SSH_KEY=~/.ssh/your_deploy_key
DEPLOY_REMOTE_PATH=/home/ubuntu/smart-ship-automation